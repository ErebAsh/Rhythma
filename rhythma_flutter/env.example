# Flutter reads the backend URL from --dart-define.
# Default is HTTPS (production). For local development use:
#
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000/api/v1
#
# Examples:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000/api/v1   (Android emulator)
#   flutter run --dart-define=API_BASE_URL=http://localhost:8000/api/v1  (desktop/web)
#
# The debug Android manifest allows cleartext traffic, so HTTP URLs work
# in debug builds. Release builds require HTTPS.

API_BASE_URL=http://10.0.2.2:8000/api/v1
