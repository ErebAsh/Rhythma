# COOKIE_SECURE=true by default (required in production over HTTPS).
# Uncomment for local dev over plain http://localhost:
# COOKIE_SECURE=false
# =========================
# Required
# =========================
JWT_SECRET=your-secret-key-here

# =========================
# CORS
# =========================
# Comma-separated list of allowed origins for CORS.
# Defaults to localhost URLs for local development.
# Set this to your production domain(s) when deploying.
# Example: ALLOWED_ORIGINS=https://app.rhythma.com,https://admin.rhythma.com
# ALLOWED_ORIGINS=https://yourdomain.com

# =========================
# Firebase Service Account (choose one method)
# =========================
# Option 1: JSON string (paste the entire JSON content)
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...",...}'

# Option 2: Path to JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./path/to/service-account.json

# =========================
# Optional (for Gemini)
# =========================
GEMINI_API_KEY=your-gemini-api-key

# =========================
# Optional (for Gemini – rate limiting)
# =========================
# Maximum number of chat requests per user within the window (default: 10)
ASSISTANT_RATE_LIMIT=10
# Sliding window in seconds for the rate limit (default: 60)
ASSISTANT_RATE_WINDOW=60

# =========================
# Optional (for Twilio – SMS)
# =========================
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890